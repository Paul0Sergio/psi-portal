# ==============================================================================
# PSI-PORTAL: MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
#
# INSTRUÇÕES DE SEGURANÇA:
# 1. Copie este arquivo para .env na raiz do projeto:
#    cp .env.example .env
# 2. Preencha as variáveis abaixo com suas credenciais seguras.
# 3. NUNCA faça commit do arquivo .env no Git! Ele está estritamente protegido
#    pelo .gitignore para evitar vazamento de dados confidenciais.
# ==============================================================================

# Porta de execução do servidor Node.js
PORT=3000

# Ambiente de execução (development ou production)
NODE_ENV=development

# Segredo da Sessão (Utilize uma string longa, forte e pseudo-aleatória)
# Exemplo para gerar no terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=insira_uma_chave_secreta_longa_e_aleatoria_aqui

# Credenciais Administrativas do Portal
ADMIN_USER=admin
ADMIN_PASS=defina_uma_senha_forte_aqui

# Tempo de expiração da sessão segura em milissegundos (ex: 2 horas = 7200000 ms)
SESSION_MAX_AGE=7200000

# Senha mestre para autorização e liberação de detalhes de setores restritos
SECTOR_MASTER_PASS=defina_uma_senha_mestre_para_gestao_de_setores

# (Opcional) Senhas individuais personalizadas por setor
SECTOR_ENSINO_PESQUISA_PASS=senha_personalizada_ensino
SECTOR_COMPRAS_FORNECEDORES_PASS=senha_personalizada_compras
SECTOR_CEOP_CIRURGICO_PASS=senha_personalizada_cirurgico
SECTOR_ALMOXARIFADO_PASS=senha_personalizada_almoxarifado
SECTOR_FATURAMENTO_PASS=senha_personalizada_faturamento
